# Copia este archivo como .env (no se sube al repositorio) y complétalo antes de `npm run apk`.

# Intermediario del catálogo de YouTube Music (worker/ytm-proxy.js, publicado con `npm run worker:publicar`).
# Obligatorio en el APK: sin él no cargan Inicio, la búsqueda ni las radios.
VITE_YTM_PROXY=https://tu-worker.workers.dev

# Opcional: clave de la YouTube Data API v3, respaldo si el catálogo no responde.
VITE_YT_API_KEY=
